{
  "name": "@virvixr/streaming",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Virvi Streaming Media Server — RTMP ingest + HLS transcoding",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "node-media-server": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
