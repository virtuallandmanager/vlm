           this.fetch,
           blueprint.props,
           this.setTimeout,
@@ -499,6 +499,27 @@ export class App extends Entity {
     return this.worldProxy
   }
 
+  // VLM: the app proxy for this run of the script. On the server, when the server says `blueprint` is the shipped VLM
+  // app (src/server/vlm.js), it also has `vlmVouch`, which vouches for a player with VLM from Node (the world secret
+  // never reaches a script); everywhere else it is the plain app proxy, where `app.vlmVouch` is undefined. Made per run
+  // and never stored on the entity, so an edited script, or a callback an edited script left behind, never gets it even
+  // after the shipped script is put back.
+  getScriptAppProxy(blueprint) {
+    const appProxy = this.getAppProxy()
+    const vlmVouch = this.world.network.isServer ? this.world.vlmVouchFor?.(blueprint) : undefined
+    if (!vlmVouch) return appProxy
+    return new Proxy(
+      {},
+      {
+        get: (target, prop) => (prop === 'vlmVouch' ? vlmVouch : appProxy[prop]),
+        set: (target, prop, value) => {
+          if (prop !== 'vlmVouch') appProxy[prop] = value
+          return true
+        },
+      }
+    )
+  }
+
   getAppProxy() {
     if (!this.appProxy) {
       const entity = this
diff --git a/src/server/index.js b/src/server/index.js
