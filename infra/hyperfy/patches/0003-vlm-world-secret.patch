From 5ae95ce19c7d3593b26b4fda731e1481e09ca82c Mon Sep 17 00:00:00 2001
From: VLM <noreply@vlm.gg>
Date: Wed, 21 Oct 2026 00:33:43 -0400
Subject: [PATCH] feat(server): server-only app.vlmWorld for the shipped VLM
 app

The server half of blueprint vlm reads app.vlmWorld = { secret, apiUrl,
worldKey } from VLM_WORLD_SECRET, VLM_FEED_URL and VLM_WORLD_KEY, but only
while its script is still the asset installVlmApp installed from vlm.hyp.
The value goes to that script run's own app proxy, never into blueprint
data, entity state or packets; clients, other apps, edited scripts and
self-run worlds (no VLM_WORLD_SECRET) read undefined.
---
 src/core/entities/App.js | 22 +++++++++++++++++++++-
 src/server/index.js      |  3 +++
 src/server/vlm.js        | 18 ++++++++++++++++++
 3 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/src/core/entities/App.js b/src/core/entities/App.js
index 2921d77..4d4b5e9 100644
--- a/src/core/entities/App.js
+++ b/src/core/entities/App.js
@@ -143,7 +143,7 @@ export class App extends Entity {
       try {
         this.script.exec(
           this.getWorldProxy(),
-          this.getAppProxy(),
+          this.getScriptAppProxy(blueprint),
           this.fetch,
           blueprint.props,
           this.setTimeout,
@@ -499,6 +499,26 @@ export class App extends Entity {
     return this.worldProxy
   }
 
+  // VLM: the app proxy for this run of the script. On the server, when the server says `blueprint` is the shipped VLM
+  // app (src/server/vlm.js), it also reads `vlmWorld`, the world's server-only VLM values; everywhere else it is the
+  // plain app proxy, where `app.vlmWorld` is undefined. Made per run and never stored on the entity, so an edited script,
+  // or a callback an edited script left behind, never sees the values even after the shipped script is put back.
+  getScriptAppProxy(blueprint) {
+    const appProxy = this.getAppProxy()
+    const vlmWorld = this.world.network.isServer ? this.world.vlmWorldFor?.(blueprint) : undefined
+    if (!vlmWorld) return appProxy
+    return new Proxy(
+      {},
+      {
+        get: (target, prop) => (prop === 'vlmWorld' ? vlmWorld : appProxy[prop]),
+        set: (target, prop, value) => {
+          if (prop !== 'vlmWorld') appProxy[prop] = value
+          return true
+        },
+      }
+    )
+  }
+
   getAppProxy() {
     if (!this.appProxy) {
       const entity = this
diff --git a/src/server/index.js b/src/server/index.js
index efc04b7..a444aeb 100644
--- a/src/server/index.js
+++ b/src/server/index.js
@@ -15,6 +15,7 @@ import multipart from '@fastify/multipart'
 
 import { createServerWorld } from '../core/createServerWorld'
 import { getDB } from './db'
+import { vlmWorldFor } from './vlm'
 import { Storage } from './Storage'
 import { assets } from './assets'
 import { collections } from './collections'
@@ -86,6 +87,8 @@ const storage = new Storage(path.join(worldDir, '/storage.json'))
 
 // create world
 const world = createServerWorld()
+// VLM: the server-only values the shipped VLM app's server half reads as app.vlmWorld (see src/server/vlm.js)
+world.vlmWorldFor = vlmWorldFor
 await world.init({
   assetsDir: assets.dir,
   assetsUrl: assets.url,
diff --git a/src/server/vlm.js b/src/server/vlm.js
index efad187..2e2cab2 100644
--- a/src/server/vlm.js
+++ b/src/server/vlm.js
@@ -7,6 +7,23 @@ import { assets } from './assets'
 
 const BLUEPRINT_ID = 'vlm'
 
+// the script asset this boot installed for blueprint `vlm`; server memory only, never blueprint data
+let shippedScript = null
+
+/**
+ * VLM: the world's server-only VLM values, `{ secret, apiUrl, worldKey }` from VLM_WORLD_SECRET, VLM_FEED_URL and
+ * VLM_WORLD_KEY, for a run of `blueprint`'s script; the server hands them to that run as `app.vlmWorld`
+ * (`App.getScriptAppProxy`). Only for blueprint `vlm` while its script is still the one installVlmApp installed from
+ * vlm.hyp: a builder's edit is a new script asset and gets undefined, as does every other app. Undefined when
+ * VLM_WORLD_SECRET is unset (a self-run world). Never put these in blueprint props, entity state or any packet.
+ */
+export function vlmWorldFor(blueprint) {
+  const secret = process.env.VLM_WORLD_SECRET
+  if (!secret || !shippedScript) return undefined
+  if (blueprint?.id !== BLUEPRINT_ID || blueprint.script !== shippedScript) return undefined
+  return Object.freeze({ secret, apiUrl: process.env.VLM_FEED_URL, worldKey: process.env.VLM_WORLD_KEY })
+}
+
 /**
  * VLM: installs the VLM app (built into the image at /app/vlm/vlm.hyp) as blueprint `vlm` on every boot, with
  * `feedUrl` and `worldKey` from VLM_FEED_URL and VLM_WORLD_KEY, and keeps exactly one `vlm` entity (created at the
@@ -61,5 +78,6 @@ export async function installVlmApp(db) {
       .whereIn('id', entities.slice(1).map(e => e.id))
       .delete()
   }
+  shippedScript = app.blueprint.script || null
   console.log(`[vlm] app installed (blueprint ${BLUEPRINT_ID})`)
 }
