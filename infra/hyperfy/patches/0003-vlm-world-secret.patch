diff --git a/src/server/vlm.js b/src/server/vlm.js
index efad187..cb2f5e2 100644
--- a/src/server/vlm.js
+++ b/src/server/vlm.js
@@ -4,9 +4,193 @@ import { isEqual } from 'lodash-es'
 import { uuid } from '../core/utils'
 import { importApp } from '../core/extras/appTools'
 import { assets } from './assets'
+import { Worker } from 'worker_threads'
 
 const BLUEPRINT_ID = 'vlm'
 
+// the script asset this boot installed for blueprint `vlm`; server memory only, never blueprint data
+let shippedScript = null
+
+/**
+ * VLM: `app.vlmVouch` for a run of `blueprint`'s script (`App.getScriptAppProxy` hands it to that run only, on the
+ * server). Defined only for blueprint `vlm` while its script is still the one installVlmApp installed from vlm.hyp (a
+ * builder's edit is a new script asset and gets undefined, as does every other app), and only on a hosted world, where
+ * installVlmApp started the vouch worker (VLM_WORLD_SECRET, VLM_FEED_URL and VLM_WORLD_KEY all set). Otherwise
+ * undefined (a self-run world).
+ *
+ * `vlmVouch({ hyperfyPlayerId, playerName, pendingPairingId })` resolves VLM's answer to
+ * POST ${VLM_FEED_URL}/api/hyperfy/pairings/vouch with only the expected fields, `{ status: 'unauthorized' }` when VLM
+ * refuses the world secret (401), or `{ status: 'error' }`. It refuses, without calling VLM, a player who isn't
+ * connected or isn't a builder or admin. A name longer than 256 characters is truncated.
+ *
+ * The world secret never enters this realm's env or a script: every app script shares this realm, and Hyperfy's
+ * lockdown leaves its intrinsics mutable. The request is made by a worker thread (a separate realm) that installVlmApp
+ * starts before any script runs, handing it the secret in workerData; the secret is then deleted from process.env.
+ * Every option bag handed to Node here has no prototype, so nothing a script adds to Object.prototype is read as an
+ * option.
+ */
+export function vlmVouchFor(world, blueprint) {
+  if (!workerConfig) return undefined
+  if (!shippedScript || blueprint?.id !== BLUEPRINT_ID || blueprint.script !== shippedScript) return undefined
+  return async function vlmVouch(req) {
+    const r = req && typeof req === 'object' ? req : {}
+    const hyperfyPlayerId = r.hyperfyPlayerId
+    const name = r.playerName
+    const pendingPairingId = r.pendingPairingId
+    if (typeof hyperfyPlayerId !== 'string' || !hyperfyPlayerId || hyperfyPlayerId.length > MAX_FIELD) return { status: 'error' }
+    if (pendingPairingId !== undefined && (typeof pendingPairingId !== 'string' || !pendingPairingId || pendingPairingId.length > MAX_FIELD)) {
+      return { status: 'error' }
+    }
+    const playerName = typeof name === 'string' && name ? name.slice(0, MAX_FIELD) : null
+    const player = world.entities.getPlayer(hyperfyPlayerId)
+    if (!player || !player.isBuilder()) return { status: 'error' }
+    const msg = { hyperfyPlayerId, playerName }
+    if (pendingPairingId !== undefined) msg.pendingPairingId = pendingPairingId
+    return await askVouchWorker(msg)
+  }
+}
+
+const MAX_FIELD = 256
+
+const nullProto = fields => Object.assign(Object.create(null), fields)
+
+/** The Worker options for the vouch worker: no prototype, every option Node reads set explicitly. */
+export function vouchWorkerOptions(config) {
+  return nullProto({
+    eval: true,
+    workerData: nullProto({ secret: config.secret, feedUrl: config.feedUrl, worldKey: config.worldKey }),
+    env: nullProto({}),
+    argv: [],
+    execArgv: [],
+    stdin: false,
+    stdout: false,
+    stderr: false,
+    resourceLimits: nullProto({}),
+    trackUnmanagedFds: true,
+    name: 'vlm-vouch',
+  })
+}
+
+/** A vouch request as posted to the worker: no prototype. */
+export function vouchMessage(id, msg) {
+  const out = nullProto({ id, hyperfyPlayerId: msg.hyperfyPlayerId, playerName: msg.playerName })
+  if (msg.pendingPairingId !== undefined) out.pendingPairingId = msg.pendingPairingId
+  return out
+}
+
+/** The worker's fetch init for a vouch (also run inside the worker, from its source): no prototype, no redirects. */
+export function vouchFetchInit(body) {
+  const init = Object.create(null)
+  const headers = Object.create(null)
+  headers['Content-Type'] = 'application/json'
+  init.method = 'POST'
+  init.headers = headers
+  init.body = body
+  init.redirect = 'error'
+  return init
+}
+
+// The vouch worker: its own realm, its config in workerData. Answers each { id, hyperfyPlayerId, playerName,
+// pendingPairingId } with { id, result }, result being VLM's answer with only the expected fields,
+// { status: 'unauthorized' } on a 401, or { status: 'error' }. Never logs.
+const VOUCH_WORKER = `
+const { parentPort, workerData } = require('node:worker_threads')
+const { secret, feedUrl, worldKey } = workerData
+const fetchInit = ${vouchFetchInit.toString()}
+const str = v => typeof v === 'string'
+function clean(r) {
+  if (!r || typeof r !== 'object') return null
+  switch (r.status) {
+    case 'linked':
+      if (![r.pass, r.passExpiresAt, r.pairingId, r.sceneId].every(str) || !r.user || !str(r.user.id) || !str(r.user.displayName)) return null
+      return { status: 'linked', pass: r.pass, passExpiresAt: r.passExpiresAt, pairingId: r.pairingId, sceneId: r.sceneId, user: { id: r.user.id, displayName: r.user.displayName } }
+    case 'unlinked':
+      if (![r.code, r.approveUrl, r.qrUrl, r.expiresAt, r.pairingId].every(str)) return null
+      return { status: 'unlinked', code: r.code, approveUrl: r.approveUrl, qrUrl: r.qrUrl, expiresAt: r.expiresAt, pairingId: r.pairingId }
+    case 'pending':
+    case 'refused':
+    case 'expired':
+      return { status: r.status }
+  }
+  return null
+}
+parentPort.on('message', async ({ id, hyperfyPlayerId, playerName, pendingPairingId }) => {
+  let result = null
+  try {
+    const body = { worldKey, worldSecret: secret, hyperfyPlayerId, playerName }
+    if (pendingPairingId !== undefined) body.pendingPairingId = pendingPairingId
+    const init = fetchInit(JSON.stringify(body))
+    init.signal = AbortSignal.timeout(15000)
+    const res = await fetch(feedUrl.replace(/\\/+$/, '') + '/api/hyperfy/pairings/vouch', init)
+    if (res.status === 401) result = { status: 'unauthorized' }
+    else if (res.ok) result = clean(await res.json())
+  } catch {}
+  parentPort.postMessage({ id, result: result || { status: 'error' } })
+})
+`
+
+// The worker's config (holds the secret, in module scope only, to restart the worker); null on a self-run world.
+let workerConfig = null
+let vouchWorker = null
+let stopped = false
+let vouchIds = 0
+const vouchWaiting = new Map()
+
+/**
+ * Starts the vouch worker when VLM_WORLD_SECRET, VLM_FEED_URL and VLM_WORLD_KEY are all set, then deletes
+ * VLM_WORLD_SECRET from process.env. Returns whether the world is hosted. installVlmApp calls it before any script runs.
+ */
+export function startVouchWorker() {
+  const { VLM_WORLD_SECRET: secret, VLM_FEED_URL: feedUrl, VLM_WORLD_KEY: worldKey } = process.env
+  delete process.env.VLM_WORLD_SECRET
+  if (!secret || !feedUrl || !worldKey) return false
+  workerConfig = Object.freeze(nullProto({ secret, feedUrl, worldKey }))
+  stopped = false
+  spawnVouchWorker()
+  return true
+}
+
+/** Whether this world vouches (the worker was started); the secret itself is never exposed. */
+export function vouchHosted() {
+  return !!workerConfig
+}
+
+/** Stops the vouch worker for good (tests). */
+export function stopVouchWorker() {
+  stopped = true
+  vouchWorker?.terminate()
+  vouchWorker = null
+}
+
+function spawnVouchWorker() {
+  const worker = new Worker(VOUCH_WORKER, vouchWorkerOptions(workerConfig))
+  worker.unref()
+  worker.on('message', ({ id, result }) => {
+    vouchWaiting.get(id)?.(result)
+    vouchWaiting.delete(id)
+  })
+  worker.on('error', () => console.error('[vlm] vouch worker crashed'))
+  worker.on('exit', () => {
+    if (vouchWorker === worker) vouchWorker = null
+    for (const resolve of vouchWaiting.values()) resolve({ status: 'error' })
+    vouchWaiting.clear()
+    // restart the same way, after a pause so a worker that can't start doesn't spin
+    if (!stopped) setTimeout(() => !stopped && !vouchWorker && spawnVouchWorker(), 1000).unref()
+  })
+  vouchWorker = worker
+}
+
+/** Sends one vouch to the worker (exported for tests); resolves its result, or `error` if the worker dies first. */
+export function askVouchWorker(msg) {
+  if (!workerConfig) return Promise.resolve({ status: 'error' })
+  if (!vouchWorker) spawnVouchWorker()
+  const id = ++vouchIds
+  return new Promise(resolve => {
+    vouchWaiting.set(id, resolve)
+    vouchWorker.postMessage(vouchMessage(id, msg))
+  })
+}
+
 /**
  * VLM: installs the VLM app (built into the image at /app/vlm/vlm.hyp) as blueprint `vlm` on every boot, with
  * `feedUrl` and `worldKey` from VLM_FEED_URL and VLM_WORLD_KEY, and keeps exactly one `vlm` entity (created at the
@@ -61,5 +245,7 @@ export async function installVlmApp(db) {
       .whereIn('id', entities.slice(1).map(e => e.id))
       .delete()
   }
+  shippedScript = app.blueprint.script || null
+  if (startVouchWorker()) console.log('[vlm] vouch worker started')
   console.log(`[vlm] app installed (blueprint ${BLUEPRINT_ID})`)
 }
