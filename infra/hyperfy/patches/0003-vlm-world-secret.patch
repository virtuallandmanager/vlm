From e89d78226bb0f9c4c177a7cce7de7a72c3c01c70 Mon Sep 17 00:00:00 2001
From: VLM <noreply@vlm.gg>
Date: Wed, 21 Oct 2026 00:33:43 -0400
Subject: [PATCH] feat(server): app.vlmVouch for the shipped VLM app, keeping
 the world secret out of scripts

The server half of blueprint vlm, while its script is still the asset
installVlmApp installed from vlm.hyp, gets app.vlmVouch({ hyperfyPlayerId,
playerName, pendingPairingId }) on that script run's own app proxy. Node
refuses players who aren't connected builders or admins, and a worker
thread (its own realm, since scripts can hook this realm's intrinsics)
POSTs VLM_FEED_URL/api/hyperfy/pairings/vouch with VLM_WORLD_KEY and
VLM_WORLD_SECRET, returning only the expected fields or { status: 'error' }.
Clients, other apps, edited scripts and self-run worlds see undefined.
---
 src/core/entities/App.js |  23 ++++++++-
 src/server/index.js      |   3 ++
 src/server/vlm.js        | 104 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 129 insertions(+), 1 deletion(-)

diff --git a/src/core/entities/App.js b/src/core/entities/App.js
index 2921d77..d2823a6 100644
--- a/src/core/entities/App.js
+++ b/src/core/entities/App.js
@@ -143,7 +143,7 @@ export class App extends Entity {
       try {
         this.script.exec(
           this.getWorldProxy(),
-          this.getAppProxy(),
+          this.getScriptAppProxy(blueprint),
           this.fetch,
           blueprint.props,
           this.setTimeout,
@@ -499,6 +499,27 @@ export class App extends Entity {
     return this.worldProxy
   }
 
+  // VLM: the app proxy for this run of the script. On the server, when the server says `blueprint` is the shipped VLM
+  // app (src/server/vlm.js), it also has `vlmVouch`, which vouches for a player with VLM from Node (the world secret
+  // never reaches a script); everywhere else it is the plain app proxy, where `app.vlmVouch` is undefined. Made per run
+  // and never stored on the entity, so an edited script, or a callback an edited script left behind, never gets it even
+  // after the shipped script is put back.
+  getScriptAppProxy(blueprint) {
+    const appProxy = this.getAppProxy()
+    const vlmVouch = this.world.network.isServer ? this.world.vlmVouchFor?.(blueprint) : undefined
+    if (!vlmVouch) return appProxy
+    return new Proxy(
+      {},
+      {
+        get: (target, prop) => (prop === 'vlmVouch' ? vlmVouch : appProxy[prop]),
+        set: (target, prop, value) => {
+          if (prop !== 'vlmVouch') appProxy[prop] = value
+          return true
+        },
+      }
+    )
+  }
+
   getAppProxy() {
     if (!this.appProxy) {
       const entity = this
diff --git a/src/server/index.js b/src/server/index.js
index efc04b7..265a3cd 100644
--- a/src/server/index.js
+++ b/src/server/index.js
@@ -15,6 +15,7 @@ import multipart from '@fastify/multipart'
 
 import { createServerWorld } from '../core/createServerWorld'
 import { getDB } from './db'
+import { vlmVouchFor } from './vlm'
 import { Storage } from './Storage'
 import { assets } from './assets'
 import { collections } from './collections'
@@ -86,6 +87,8 @@ const storage = new Storage(path.join(worldDir, '/storage.json'))
 
 // create world
 const world = createServerWorld()
+// VLM: app.vlmVouch for the shipped VLM app's server half (see src/server/vlm.js)
+world.vlmVouchFor = blueprint => vlmVouchFor(world, blueprint)
 await world.init({
   assetsDir: assets.dir,
   assetsUrl: assets.url,
diff --git a/src/server/vlm.js b/src/server/vlm.js
index efad187..7b0418b 100644
--- a/src/server/vlm.js
+++ b/src/server/vlm.js
@@ -4,9 +4,112 @@ import { isEqual } from 'lodash-es'
 import { uuid } from '../core/utils'
 import { importApp } from '../core/extras/appTools'
 import { assets } from './assets'
+import { Worker } from 'worker_threads'
 
 const BLUEPRINT_ID = 'vlm'
 
+// the script asset this boot installed for blueprint `vlm`; server memory only, never blueprint data
+let shippedScript = null
+
+/**
+ * VLM: `app.vlmVouch` for a run of `blueprint`'s script (`App.getScriptAppProxy` hands it to that run only, on the
+ * server). Defined only for blueprint `vlm` while its script is still the one installVlmApp installed from vlm.hyp (a
+ * builder's edit is a new script asset and gets undefined, as does every other app), and only on a hosted world:
+ * VLM_WORLD_SECRET, VLM_FEED_URL and VLM_WORLD_KEY all set. Otherwise undefined (a self-run world).
+ *
+ * `vlmVouch({ hyperfyPlayerId, playerName, pendingPairingId })` resolves VLM's answer to
+ * POST ${VLM_FEED_URL}/api/hyperfy/pairings/vouch with only the expected fields, or `{ status: 'error' }`. It refuses,
+ * without calling VLM, a player who isn't connected or isn't a builder or admin.
+ *
+ * The world secret never enters this realm: every app script shares it, and Hyperfy's lockdown leaves its intrinsics
+ * mutable (a script can hook Object.prototype.toJSON, JSON, typed arrays…). The request is made by a worker thread, a
+ * separate realm no script can reach, which reads the secret from its own copy of the env.
+ */
+export function vlmVouchFor(world, blueprint) {
+  if (!process.env.VLM_WORLD_SECRET || !process.env.VLM_FEED_URL || !process.env.VLM_WORLD_KEY) return undefined
+  if (!shippedScript || blueprint?.id !== BLUEPRINT_ID || blueprint.script !== shippedScript) return undefined
+  return async function vlmVouch(req) {
+    const r = req && typeof req === 'object' ? req : {}
+    const hyperfyPlayerId = shortString(r.hyperfyPlayerId)
+    const playerName = r.playerName === null || r.playerName === undefined ? null : shortString(r.playerName)
+    const pendingPairingId = r.pendingPairingId === undefined ? undefined : shortString(r.pendingPairingId)
+    if (!hyperfyPlayerId || playerName === undefined || pendingPairingId === '') return { status: 'error' }
+    const player = world.entities.getPlayer(hyperfyPlayerId)
+    if (!player || !player.isBuilder()) return { status: 'error' }
+    const msg = { hyperfyPlayerId, playerName }
+    if (pendingPairingId !== undefined) msg.pendingPairingId = pendingPairingId
+    return await askVouchWorker(msg)
+  }
+}
+
+const shortString = v => (typeof v === 'string' && v.length > 0 && v.length <= 256 ? v : typeof v === 'string' ? '' : undefined)
+
+// The vouch worker: its own realm and env copy. Answers each { id, hyperfyPlayerId, playerName, pendingPairingId } with
+// { id, result }, result being VLM's answer with only the expected fields, or { status: 'error' }. Never logs.
+const VOUCH_WORKER = `
+const { parentPort } = require('node:worker_threads')
+const env = process.env
+const str = v => typeof v === 'string'
+function clean(r) {
+  if (!r || typeof r !== 'object') return null
+  switch (r.status) {
+    case 'linked':
+      if (![r.pass, r.passExpiresAt, r.pairingId, r.sceneId].every(str) || !r.user || !str(r.user.id) || !str(r.user.displayName)) return null
+      return { status: 'linked', pass: r.pass, passExpiresAt: r.passExpiresAt, pairingId: r.pairingId, sceneId: r.sceneId, user: { id: r.user.id, displayName: r.user.displayName } }
+    case 'unlinked':
+      if (![r.code, r.approveUrl, r.qrUrl, r.expiresAt, r.pairingId].every(str)) return null
+      return { status: 'unlinked', code: r.code, approveUrl: r.approveUrl, qrUrl: r.qrUrl, expiresAt: r.expiresAt, pairingId: r.pairingId }
+    case 'pending':
+    case 'refused':
+    case 'expired':
+      return { status: r.status }
+  }
+  return null
+}
+parentPort.on('message', async ({ id, hyperfyPlayerId, playerName, pendingPairingId }) => {
+  let result = null
+  try {
+    const body = { worldKey: env.VLM_WORLD_KEY, worldSecret: env.VLM_WORLD_SECRET, hyperfyPlayerId, playerName }
+    if (pendingPairingId !== undefined) body.pendingPairingId = pendingPairingId
+    const res = await fetch(env.VLM_FEED_URL.replace(/\\/+$/, '') + '/api/hyperfy/pairings/vouch', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(body),
+      signal: AbortSignal.timeout(15000),
+    })
+    if (res.ok) result = clean(await res.json())
+  } catch {}
+  parentPort.postMessage({ id, result: result || { status: 'error' } })
+})
+`
+
+let vouchWorker = null
+let vouchIds = 0
+const vouchWaiting = new Map()
+
+function askVouchWorker(msg) {
+  if (!vouchWorker) {
+    const worker = new Worker(VOUCH_WORKER, { eval: true })
+    worker.unref()
+    worker.on('message', ({ id, result }) => {
+      vouchWaiting.get(id)?.(result)
+      vouchWaiting.delete(id)
+    })
+    worker.on('error', () => console.error('[vlm] vouch worker crashed'))
+    worker.on('exit', () => {
+      if (vouchWorker === worker) vouchWorker = null
+      for (const resolve of vouchWaiting.values()) resolve({ status: 'error' })
+      vouchWaiting.clear()
+    })
+    vouchWorker = worker
+  }
+  const id = ++vouchIds
+  return new Promise(resolve => {
+    vouchWaiting.set(id, resolve)
+    vouchWorker.postMessage({ id, ...msg })
+  })
+}
+
 /**
  * VLM: installs the VLM app (built into the image at /app/vlm/vlm.hyp) as blueprint `vlm` on every boot, with
  * `feedUrl` and `worldKey` from VLM_FEED_URL and VLM_WORLD_KEY, and keeps exactly one `vlm` entity (created at the
@@ -61,5 +164,6 @@ export async function installVlmApp(db) {
       .whereIn('id', entities.slice(1).map(e => e.id))
       .delete()
   }
+  shippedScript = app.blueprint.script || null
   console.log(`[vlm] app installed (blueprint ${BLUEPRINT_ID})`)
 }
