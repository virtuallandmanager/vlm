From 2f7f89c6cec656596e2f7bdfcb269dca03c19ea8 Mon Sep 17 00:00:00 2001
From: VLM <noreply@vlm.gg>
Date: Wed, 21 Oct 2026 00:33:43 -0400
Subject: [PATCH] feat(server): app.vlmVouch for the shipped VLM app, keeping
 the world secret out of scripts

The server half of blueprint vlm, while its script is still the asset
installVlmApp installed from vlm.hyp, gets app.vlmVouch({ hyperfyPlayerId,
playerName, pendingPairingId }) on that script run's own app proxy. Node
refuses players who aren't connected builders or admins and truncates names
to 256 characters. A worker thread (its own realm, since scripts can hook
this realm's intrinsics), started by installVlmApp before any script runs
with its config in workerData, POSTs VLM_FEED_URL/api/hyperfy/pairings/vouch
with VLM_WORLD_KEY and VLM_WORLD_SECRET (no redirects) and returns only the
expected fields, { status: 'unauthorized' } on a 401, or { status: 'error' }.
VLM_WORLD_SECRET is then deleted from the main thread's env, and every
option bag handed to Worker, postMessage and fetch has no prototype.
Clients, other apps, edited scripts and self-run worlds see undefined.
---
 src/core/entities/App.js |  23 ++++-
 src/server/index.js      |   3 +
 src/server/vlm.js        | 186 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 211 insertions(+), 1 deletion(-)

diff --git a/src/core/entities/App.js b/src/core/entities/App.js
index 2921d77..d2823a6 100644
--- a/src/core/entities/App.js
+++ b/src/core/entities/App.js
@@ -143,7 +143,7 @@ export class App extends Entity {
       try {
         this.script.exec(
           this.getWorldProxy(),
-          this.getAppProxy(),
