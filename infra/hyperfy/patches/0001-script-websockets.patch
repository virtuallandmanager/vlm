 src/core/entities/App.js            | 14 ++++-
 src/core/extras/scriptWebSockets.js | 93 +++++++++++++++++++++++++++++
 src/core/systems/Scripts.js         |  2 +-
 4 files changed, 111 insertions(+), 2 deletions(-)
 create mode 100644 src/core/extras/scriptWebSockets.js

