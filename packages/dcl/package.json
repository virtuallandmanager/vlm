{
  "name": "@virvixr/dcl",
  "version": "2.4.0",
  "description": "Virtual Land Manager for Decentraland SDK7 — analytics, in-world HUD and live scene management. Use from code or as a Creator Hub script.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "virvi-dcl": "bin/virvi-dcl.mjs"
  },
  "scripts": {
    "build": "echo 'vlm-dcl: skip in CI, build locally with pnpm run bundle'",
    "bundle": "tsc && node build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run bundle",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@dcl/sdk": ">=7.26.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@dcl/sdk": "7.30.1",
    "@types/node": "^22.0.0",
    "colyseus.js": "^0.15.26",
    "esbuild": "^0.27.4",
    "typescript": "^5.7.0",
    "@virvixr/adapter-dcl": "workspace:*",
    "@virvixr/client": "workspace:*",
    "@virvixr/core": "workspace:*",
    "@virvixr/hud": "workspace:*",
    "@virvixr/shared": "workspace:*"
  },
  "files": [
    "dist",
    "bin",
    "creator-hub",
    "assets/hud-v.png",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/virtuallandmanager/vlm.git",
    "directory": "packages/dcl"
  },
  "homepage": "https://vlm.gg",
  "keywords": [
    "decentraland",
    "sdk7",
    "analytics",
    "vlm",
    "virtual land manager",
    "creator hub"
  ]
}
