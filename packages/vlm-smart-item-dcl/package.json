{
  "name": "vlm-dcl",
  "version": "2.0.0",
  "description": "Virtual Land Manager for Decentraland SDK7 \u2014 analytics, in-world HUD and live scene management. Use from code or as a Creator Hub script.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "echo 'vlm-dcl: skip in CI, build locally with pnpm run bundle'",
    "bundle": "tsc && node build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "pnpm run bundle"
  },
  "peerDependencies": {
    "@dcl/sdk": ">=7.15.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@dcl/sdk": ">=7.7.0",
    "@types/node": "^22.0.0",
    "colyseus.js": "^0.15.26",
    "esbuild": "^0.27.4",
    "typescript": "^5.7.0",
    "vlm-adapter-dcl": "workspace:*",
    "vlm-client": "workspace:*",
    "vlm-core": "workspace:*",
    "vlm-hud": "workspace:*",
    "vlm-shared": "workspace:*"
  },
  "files": [
    "dist",
    "creator-hub",
    "README.md"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/virtuallandmanager/vlm.git",
    "directory": "packages/vlm-smart-item-dcl"
  },
  "homepage": "https://vlm.gg",
  "keywords": [
    "decentraland",
    "sdk7",
    "analytics",
    "vlm",
    "virtual land manager",
    "creator hub"
  ]
}
